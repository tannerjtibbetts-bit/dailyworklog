<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/intro_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:contentDescription="Daily Work Log logo"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.01"
            android:text="Daily Work Log"
            android:textColor="@android:color/white"
            android:textSize="42sp" />

        <View
            android:id="@+id/bar"
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@color/safety_yellow" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.2"
            android:text="B44 TOOL READINESS"
            android:textColor="#8FA1B8"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="OUR MISSION"
                android:textColor="@color/safety_yellow"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:maxWidth="340dp"
                android:text="Increasing efficiency and flow in your workday, while maintaining coverage and documenting every task with accuracy and precision."
                android:textColor="#D3DCE7"
                android:textSize="17sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/enter"
            android:layout_width="300dp"
            android:layout_height="64dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_pill_yellow"
            android:elevation="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Enter"
            android:textColor="#14233A"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Support: the user manual, before or after signing in -->
        <TextView
            android:id="@+id/support"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Support"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.7"
            android:text="App created by Tanner Tibbetts"
            android:textColor="#8FA1B8"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
