<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:elevation="1dp"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <View
        android:id="@+id/accent"
        android:layout_width="5dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.dailyworklog.app.CheckCircle
                android:id="@+id/check"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Mark complete" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:textColor="@color/navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/open"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit field"
                android:src="@drawable/ic_add_circle"
                app:tint="@color/blue" />

            <ImageButton
                android:id="@+id/camera"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Take photo"
                android:src="@drawable/ic_camera"
                app:tint="@color/blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_person_small"
                android:drawablePadding="6dp"
                android:drawableTint="@color/grey_light"
                android:gravity="center_vertical"
                android:textColor="@color/grey_light"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/assigned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_person_add"
                android:drawablePadding="6dp"
                android:drawableTint="@color/blue"
                android:gravity="center_vertical"
                android:textColor="@color/blue"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.12"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/secured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_green"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="\u2713  Load secured"
                android:textColor="#148A3A"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sideChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_outline"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:textColor="@color/navy"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nextShiftChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_sky"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="Next shift"
                android:textColor="@color/deep_blue"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip_outline"
                android:drawableStart="@drawable/ic_info_small"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp"
                android:text="Photos Required"
                android:textSize="16sp" />

            <HorizontalScrollView
                android:id="@+id/photoScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/photos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
